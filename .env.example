# Create a Resend account and verify your sender domain before going live.
# Never place these values in NEXT_PUBLIC_ variables or commit your .env.local.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=BAE <hello@your-verified-domain.com>
# The address below matches the supplied requirement exactly. CONFIRM SPELLING: "gmaill.com" has two l's.
CONTACT_TO_EMAIL=devstack912@gmaill.com

# Proxima Nova is a commercial font. Create your own licensed Adobe Fonts web project,
# or supply licensed self-hosted WOFF2 files yourself, then set this kit ID:
NEXT_PUBLIC_ADOBE_FONTS_KIT_ID=
